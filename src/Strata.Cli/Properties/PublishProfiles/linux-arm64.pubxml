<?xml version="1.0" encoding="utf-8"?>
<!--
  User Story 4 (CI integration) — self-contained single-file publish profile.
  Produces a single `strata` executable for linux-arm64 with no separate .NET runtime
  install required on the target host (contracts/github-action.md FR-021).

  Usage:
    dotnet publish src/Strata.Cli/Strata.Cli.csproj -c Release -p:PublishProfile=linux-arm64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
    <PublishDir>bin\Release\net10.0\linux-arm64\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>

    <!-- Single, self-contained, runtime-free binary (FR-021). -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Keep IL intact — trimming a reflection-using CLI is out of scope for this story. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>

    <!-- Principle IV: deterministic, reproducible builds. -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
