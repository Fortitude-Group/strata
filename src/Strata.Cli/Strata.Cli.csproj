<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Strata.Core\Strata.Core.csproj" />
    <ProjectReference Include="..\Strata.Corpus\Strata.Corpus.csproj" />
    <ProjectReference Include="..\Strata.Sbom\Strata.Sbom.csproj" />
    <ProjectReference Include="..\Strata.Vuln\Strata.Vuln.csproj" />
  </ItemGroup>

  <ItemGroup>
