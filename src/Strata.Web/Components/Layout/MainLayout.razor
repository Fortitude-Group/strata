@inherits LayoutComponentBase

<div class="page">
    <header class="page-header">
        <span class="wordmark">Strata</span>
        <span class="tagline">Evidence-backed SBOMs from native binaries — public demo</span>
    </header>

    <main>
        @Body
    </main>

    <footer class="page-footer">
        Strata reports evidence, confidence, and unattributed regions for every scan — it does not
        certify regulatory compliance. Uploaded files are scanned in memory and are never written to
        disk or retained after the response.
    </footer>
</div>
