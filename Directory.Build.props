<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Principle IV: deterministic, reproducible builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Quality gate #3: build clean, compiler warnings are errors.
         Code-style (IDE****) is enforced separately via `dotnet format` in CI, not the compile. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <!-- Domain naming: binary-analysis terms carry underscores/keywords by convention
         (e.g. X86_64, a `function` parameter). CA1707/CA1716 are interop-style rules we
         deliberately waive; real correctness analyzers stay on. -->
    <NoWarn>$(NoWarn);CA1707;CA1716</NoWarn>

    <!-- Shared identity -->
    <Company>Fortitude Omnis Group</Company>
    <Product>Strata</Product>
    <Authors>Fortitude Omnis</Authors>
    <Copyright>Copyright 2026 Fortitude Omnis Group</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
